---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pag3b Keyboard - Parametric Hardware Design",
  description = "あなたの手の形にだけ合うキーボードを自動生成するパラメトリック・ハードウェア・デザインプロジェクト",
}: Props = Astro.props;

// Use Astro.url directly since site is not configured
const canonicalURL = Astro.url.href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Global Styles -->
    <style is:global>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+JP:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap");

      /* ===== CSS Variables ===== */
      :root {
        /* Colors - Technical Design Theme */
        --color-bg-primary: #08080c;
        --color-bg-secondary: #111115;
        --color-bg-tertiary: #1a1a1e;
        --color-accent: #3b82f6;
        --color-accent-light: #60a5fa;
        --color-accent-dark: #2563eb;
        --color-text-primary: #f5f5f0;
        --color-text-secondary: #9ca3af;
        --color-border: #e5e5e5;
        --color-border-subtle: rgba(229, 229, 229, 0.15);

        /* Legacy color names for backwards compatibility */
        --color-neon-cyan: #3b82f6;
        --color-neon-pink: #3b82f6;
        --color-neon-purple: #3b82f6;
        --color-grid-line: rgba(59, 130, 246, 0.08);

        /* Spacing */
        --spacing-xs: 0.25rem;
        --spacing-sm: 0.5rem;
        --spacing-md: 1rem;
        --spacing-lg: 2rem;
        --spacing-xl: 4rem;
        --spacing-2xl: 6rem;

        /* Typography */
        --font-japanese: "Noto Sans JP", sans-serif;
        --font-headline: "Space Grotesk", sans-serif;
        --font-body: "Inter", sans-serif;
        --font-mono: "JetBrains Mono", monospace;

        /* Border Radius */
        --radius-sm: 4px;
        --radius-md: 8px;
        --radius-lg: 12px;
        --radius-xl: 16px;

        /* Transitions */
        --transition-fast: 150ms ease;
        --transition-base: 250ms ease;
        --transition-slow: 500ms cubic-bezier(0.4, 0, 0.2, 1);
      }

      /* ===== Reset & Base Styles ===== */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        font-size: 16px;
      }

      body {
        font-family: var(--font-japanese), var(--font-body);
        background-color: var(--color-bg-primary);
        color: var(--color-text-primary);
        line-height: 1.6;
        overflow-x: hidden;
        text-autospace: normal;
        overflow-wrap: anywhere;
        word-break: normal;
        line-break: strict;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: var(--font-headline);
        font-weight: 600;
        line-height: 1.2;
        margin-bottom: var(--spacing-md);
        color: var(--color-text-primary);
      }

      h1 {
        font-size: clamp(2rem, 5vw, 4rem);
      }

      h2 {
        font-size: clamp(1.5rem, 3vw, 2.5rem);
      }

      h3 {
        font-size: clamp(1.125rem, 2vw, 1.75rem);
      }

      p {
        margin-bottom: var(--spacing-md);
        color: var(--color-text-secondary);
      }

      a {
        color: var(--color-accent);
        text-decoration: none;
        transition: color var(--transition-fast);
      }

      a:hover {
        color: var(--color-accent-light);
      }

      code,
      .code {
        font-family: var(--font-mono);
        background: var(--color-bg-tertiary);
        padding: 0.2em 0.4em;
        border-radius: var(--radius-sm);
        font-size: 0.9em;
      }

      /* ===== Scrollbar ===== */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }

      ::-webkit-scrollbar-track {
        background: var(--color-bg-primary);
      }

      ::-webkit-scrollbar-thumb {
        background: var(--color-bg-tertiary);
        border-radius: var(--radius-sm);
      }

      ::-webkit-scrollbar-thumb:hover {
        background: var(--color-accent);
      }

      /* ===== Selection ===== */
      ::selection {
        background: var(--color-accent);
        color: white;
      }

      /* ===== Focus Styles ===== */
      :focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
      }

      /* ===== Technical Grid Background Pattern ===== */
      .grid-background {
        position: fixed;
        inset: 0;
        background-image:
          linear-gradient(rgba(59, 130, 246, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(59, 130, 246, 0.03) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
        z-index: -1;
      }

      /* ===== Noise Texture Overlay ===== */
      .noise-overlay {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 9998;
        opacity: 0.02;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
      }

      /* ===== Accent Text ===== */
      .accent-text {
        color: var(--color-accent);
      }

      /* ===== Card Border Styles ===== */
      .card-border {
        border: 1px solid var(--color-border-subtle);
        transition: border-color var(--transition-base);
      }

      .card-border:hover {
        border-color: var(--color-accent);
      }

      /* ===== Container ===== */
      .container {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 var(--spacing-lg);
      }

      .container-narrow {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
        padding: 0 var(--spacing-lg);
      }

      /* ===== Section ===== */
      .section {
        position: relative;
        padding: var(--spacing-2xl) 0;
      }

      .section--secondary {
        background-color: var(--color-bg-secondary);
      }

      /* ===== Responsive ===== */
      @media (max-width: 768px) {
        :root {
          --spacing-lg: 1.5rem;
          --spacing-xl: 3rem;
          --spacing-2xl: 4rem;
        }

        .section {
          padding: var(--spacing-xl) 0;
        }
      }
    </style>

    <!-- AOS CSS (will be loaded via CDN for now) -->
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    <!-- AOS Library -->
    <script is:inline src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
  </head>
  <body>
    <!-- Noise Texture Overlay -->
    <div class="noise-overlay" aria-hidden="true"></div>

    <!-- Technical Grid Background -->
    <div class="grid-background" aria-hidden="true"></div>

    <!-- Navigation -->
    <header class="nav" role="navigation">
      <nav class="container">
        <ul class="nav__list">
          <li><a href="#hero" class="nav__link">Top</a></li>
          <li><a href="#about" class="nav__link">About</a></li>
          <li><a href="#features" class="nav__link">Features</a></li>
          <li><a href="#specs" class="nav__link">Specs</a></li>
          <li><a href="#demo" class="nav__link">Demo</a></li>
          <li><a href="#technical" class="nav__link">Technical</a></li>
          <li><a href="#resources" class="nav__link">Resources</a></li>
          <li><a href="#future" class="nav__link">Future</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer__content">
          <p class="footer__text">
            &copy; 2025 Pag3b Keyboard Project. All rights reserved.
          </p>
          <p class="footer__text">Designed by yuki ueyama</p>
          <div class="footer__links">
            <a
              href="https://x.com/PAG3B"
              target="_blank"
              rel="noopener noreferrer"
              class="footer__link"
              aria-label="X (旧Twitter) @PAG3B"
            >
              <svg
                class="footer__link-icon"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                ></path>
              </svg>
              <span>@PAG3B</span>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- AOS Initialization -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        if (typeof AOS !== "undefined") {
          AOS.init({
            duration: 800,
            easing: "ease-out-cubic",
            once: true,
            offset: 100,
          });
        }
      });
    </script>
  </body>
</html>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(8, 8, 12, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .nav__list {
    display: flex;
    list-style: none;
    gap: var(--spacing-md);
    padding: var(--spacing-md) 0;
    overflow-x: auto;
  }

  .nav__link {
    font-family: var(--font-headline);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .nav__link:hover {
    color: var(--color-accent);
  }

  .footer {
    position: relative;
    padding: var(--spacing-lg) 0;
    background: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border-subtle);
    margin-top: var(--spacing-2xl);
  }

  .footer__content {
    text-align: center;
  }

  .footer__text {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .footer__links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-md);
    margin-top: var(--spacing-md);
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__link:hover {
    color: var(--color-accent-light);
  }

  .footer__link-icon {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 768px) {
    .nav__list {
      gap: var(--spacing-sm);
      padding: var(--spacing-sm) 0;
    }

    .nav__link {
      font-size: 0.625rem;
    }
  }
</style>
