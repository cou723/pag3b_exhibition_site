---
import SectionTitle from '@/components/ui/SectionTitle.astro';
import TechCard from '@/components/ui/TechCard.astro';
import type { FutureItem } from '@/data/content';
import { future } from '@/data/content';
---

<section id="future" class="section">
  <div class="container">
    <SectionTitle
      title="Future"
      subtitle="現状の課題＆将来の展望"
      align="center"
      id="future-title"
    />

    <div class="future__grid">
      {
        future.map((item: FutureItem, index: number) => (
          <TechCard
            class="future__card"
            data-aos="fade-up"
            data-aos-delay={(index * 100).toString()}
          >
            <div class="future__header">
              <span class="future__category">{item.category}</span>
            </div>
            <h3 class="future__title">{item.title}</h3>
            <ul class="future__challenges">
              {item.challenges.map((challenge: string) => (
                <li>{challenge}</li>
              ))}
            </ul>
          </TechCard>
        ))
      }
    </div>

    <div class="future__message" data-aos="fade-up">
      <p class="future__message-text">
        これらの課題に対して、今後も開発を続けてまいります。<br />
        ご意見・ご感想をお待ちしております。
      </p>
    </div>
  </div>
</section>

<style>
  .future__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .future__card {
    height: 100%;
  }

  .future__header {
    margin-bottom: var(--spacing-md);
  }

  .future__category {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--color-bg-tertiary);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
  }

  .future__title {
    font-family: var(--font-headline);
    font-size: 1.125rem;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-md);
  }

  .future__challenges {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .future__challenges li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: var(--spacing-sm);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .future__challenges li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .future__challenges li:last-child {
    margin-bottom: 0;
  }

  .future__message {
    text-align: center;
    padding: var(--spacing-xl);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-accent);
  }

  .future__message-text {
    font-size: 1rem;
    color: var(--color-text-primary);
    margin: 0;
  }

  @media (max-width: 768px) {
    .future__grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .future__message {
      padding: var(--spacing-lg);
    }

    .future__message-text {
      font-size: 0.9375rem;
    }
  }
</style>
