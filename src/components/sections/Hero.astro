---
import { Image } from "astro:assets";
import TechButton from "@/components/ui/TechButton.astro";
import keyboardImage from "@/assets/images/hero/keyboard-02.webp";
---

<section id="hero" class="hero">
  <div class="container hero__container">
    <div class="hero__content">
      <div class="hero__main" data-aos="fade-up">
        <p class="hero__subtitle">Parametric Hardware Design</p>
        <h1 class="hero__title">
          <span class="accent-text">Pag3b</span> Keyboard
        </h1>
        <p class="hero__description">
          あなたの手の形にだけ合うキーボードを<br class="hero__br" />
          自動生成するパラメトリック・ハードウェア・デザインプロジェクト
        </p>
        <div class="hero__cta">
          <TechButton href="#demo" variant="primary" size="lg">
            体験する
          </TechButton>
          <TechButton href="#about" variant="secondary" size="lg">
            もっと詳しく
          </TechButton>
        </div>
      </div>

      <div class="hero__visual" data-aos="fade-left" data-aos-delay="200">
        <div class="hero__keyboard-preview">
          <Image
            src={keyboardImage}
            alt="Pag3b Keyboard - パラメトリックデザインで自動生成されたキーボード"
            class="hero__image"
            loading="eager"
            format="webp"
            width={1920}
            height={1200}
          />
        </div>
      </div>
    </div>

    <div class="hero__scroll">
      <span class="scroll-indicator"></span>
    </div>
  </div>

  <style>
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding-top: var(--spacing-2xl);
      padding-bottom: var(--spacing-2xl);
    }

    .hero__container {
      width: 100%;
    }

    .hero__content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-2xl);
      align-items: center;
      width: 100%;
    }

    .hero__main {
      max-width: 600px;
    }

    .hero__subtitle {
      font-family: var(--font-headline);
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.2em;
      margin-bottom: var(--spacing-sm);
    }

    .hero__title {
      font-family: var(--font-headline);
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 700;
      line-height: 1.1;
      margin-bottom: var(--spacing-md);
    }

    .hero__description {
      font-size: 1.125rem;
      line-height: 1.8;
      margin-bottom: var(--spacing-lg);
    }

    .hero__br {
      display: none;
    }

    .hero__cta {
      display: flex;
      gap: var(--spacing-md);
      flex-wrap: wrap;
    }

    .hero__visual {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .hero__keyboard-preview {
      width: 100%;
      max-width: 500px;
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-xl);
      overflow: hidden;
      transition: border-color var(--transition-base);
    }

    .hero__keyboard-preview:hover {
      border-color: var(--color-accent);
    }

    .hero__image {
      width: 100%;
      height: auto;
      display: block;
    }

    .hero__scroll {
      position: absolute;
      bottom: var(--spacing-lg);
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--spacing-sm);
    }

    .scroll-indicator {
      width: 2px;
      height: 40px;
      background: linear-gradient(to bottom, var(--color-accent), transparent);
      animation: scrollBounce 2s infinite;
    }

    @keyframes scrollBounce {
      0%,
      100% {
        transform: scaleY(0.5);
        opacity: 0.5;
      }
      50% {
        transform: scaleY(1);
        opacity: 1;
      }
    }

    /* Extra large screens */
    @media (min-width: 1400px) {
      .hero__content {
        gap: var(--spacing-2xl);
      }

      .hero__main {
        max-width: 650px;
      }

      .hero__keyboard-preview {
        max-width: 600px;
      }
    }

    /* Tablet */
    @media (max-width: 1024px) {
      .hero__content {
        grid-template-columns: 1fr;
        gap: var(--spacing-xl);
      }

      .hero__main {
        max-width: 100%;
        text-align: center;
      }

      .hero__cta {
        justify-content: center;
      }
    }

    @media (max-width: 768px) {
      .hero {
        padding-top: var(--spacing-xl);
        padding-bottom: var(--spacing-xl);
      }

      .hero__br {
        display: inline;
      }

      .hero__title {
        font-size: 2rem;
      }

      .hero__description {
        font-size: 1rem;
      }

      .hero__cta {
        flex-direction: column;
        align-items: stretch;
      }

      .hero__keyboard-preview {
        max-width: 100%;
      }
    }
  </style>
</section>
